# Possible values: local, staging, production, ci, testing, other
ENVIRONMENT=local

# IRC server identity
IRC_SERVER_NAME=irc.local
IRC_NETWORK_NAME=PHPIRC
IRC_SERVER_VERSION=phpirc-0.1.0

# Connection keepalive (seconds)
IRC_PING_INTERVAL=120
IRC_PONG_TIMEOUT=30

# Inbound command flood protection
IRC_FLOOD_BURST_MESSAGES=20
IRC_FLOOD_MESSAGES_PER_SECOND=2

# TCP listener
LISTEN_ADDRESS=127.0.0.1
LISTEN_PORT=6667
